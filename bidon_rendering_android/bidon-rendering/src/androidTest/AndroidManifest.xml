<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tests serve documents, videos and pixels from a local server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cleartext for the local test server on 127.0.0.1, whatever the test APK's target SDK. -->
    <application android:usesCleartextTraffic="true">
        <!-- Telemetry is off unless the host app switches it on; tests of it need it on. -->
        <meta-data
            android:name="org.bidon.rendering.telemetry"
            android:value="true" />

        <!-- An empty screen for tests that need a view attached to a real window. -->
        <activity
            android:name="org.bidon.rendering.ui.BlankActivity"
            android:exported="false" />

        <!-- Owns a telemetry queue in a process of its own, so tests can kill it and read back what survived. -->
        <service
            android:name="org.bidon.rendering.telemetry.VictimService"
            android:exported="false"
            android:process=":victim" />
    </application>

</manifest>
